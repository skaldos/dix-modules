#!/bin/sh
set -eu

integration_root=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
module_root=$(CDPATH='' cd "$integration_root/.." && pwd -P)
env_file=${DIX_ENV:-$HOME/.dix/env}

[ -r "$env_file" ] || {
    printf 'DIX environment file is not readable: %s\n' "$env_file" >&2
    exit 1
}
. "$env_file"

for variable in DIX_SOURCE_ROOT DIX_VENV DIX_LAUNCHERS DIX_BIN; do
    eval "value=\${$variable:-}"
    [ -n "$value" ] || {
        printf 'DIX environment value is missing: %s\n' "$variable" >&2
        exit 1
    }
done
[ -x "$DIX_VENV/bin/python" ] || {
    printf 'DIX environment Python is not executable: %s\n' "$DIX_VENV/bin/python" >&2
    exit 1
}

for module in \
    "$DIX_SOURCE_ROOT/modules/dix/state" \
    "$DIX_SOURCE_ROOT/modules/dix/cli" \
    "$DIX_SOURCE_ROOT/modules/dix/norn" \
    "$DIX_SOURCE_ROOT/modules/dix/roba" \
    "$module_root"
do
    [ -d "$module" ] || {
        printf 'DIX module root is not a directory: %s\n' "$module" >&2
        exit 1
    }
done

mkdir -p "$DIX_LAUNCHERS/cockpit/assets" "$DIX_LAUNCHERS/cockpit/zsh" "$DIX_BIN"
chmod 0700 "$DIX_LAUNCHERS/cockpit" "$DIX_LAUNCHERS/cockpit/assets" "$DIX_LAUNCHERS/cockpit/zsh"

runtime_module="$DIX_LAUNCHERS/cockpit/runtime-module"
"$DIX_VENV/bin/python" - "$module_root" "$runtime_module" <<'PY'
from __future__ import annotations

import os
import shutil
import sys
import tempfile
import uuid
from pathlib import Path

source = Path(sys.argv[1]).resolve(strict=True)
target = Path(sys.argv[2]).resolve(strict=False)
files = (
    "apps/cli/app.toml",
    "apps/cli/runtime.py",
    "apps/owner_shell/app.toml",
    "apps/owner_shell/runtime.py",
    "apps/runtime_status/app.toml",
    "apps/runtime_status/runtime.py",
    "compositions/config/composition.toml",
    "compositions/config/runtime.py",
    "compositions/roba_runtime/composition.toml",
    "compositions/roba_runtime/runtime.py",
    "compositions/tmux_workspace/composition.toml",
    "compositions/tmux_workspace/runtime.py",
    "compositions/cockpit_session/composition.toml",
    "compositions/cockpit_session/runtime.py",
    "assets/dix.png",
    "assets/roba.png",
    "integrations/tmux/cockpit.conf",
    "integrations/zsh/.zshrc",
)

target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
target.parent.chmod(0o700)
if target.is_symlink() or (target.exists() and not target.is_dir()):
    raise RuntimeError(f"Cockpit runtime module target must be a directory: {target}")

temporary = Path(tempfile.mkdtemp(prefix=".runtime-module-", dir=target.parent))
backup: Path | None = None
try:
    temporary.chmod(0o700)
    for relative in files:
        origin = source / relative
        if origin.is_symlink() or not origin.is_file():
            raise RuntimeError(f"Cockpit runtime source must be a regular file: {origin}")
        destination = temporary / relative
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        destination.parent.chmod(0o700)
        shutil.copyfile(origin, destination)
        destination.chmod(0o600)

    if target.exists():
        backup = target.parent / f".runtime-module-old-{uuid.uuid4().hex}"
        os.replace(target, backup)
    try:
        os.replace(temporary, target)
    except BaseException:
        if backup is not None:
            os.replace(backup, target)
            backup = None
        raise
    if backup is not None:
        shutil.rmtree(backup)
        backup = None
finally:
    if temporary.exists():
        shutil.rmtree(temporary)
    if backup is not None and backup.exists():
        shutil.rmtree(backup)
PY

for name in dix-cockpit dix-cockpit-owner-shell dix-cockpit-runtime-status; do
    launcher_spec="$DIX_LAUNCHERS/$name.toml"
    "$DIX_VENV/bin/python" - \
        "$integration_root/launchers/$name.toml" \
        "$launcher_spec" \
        "$DIX_SOURCE_ROOT/modules/dix/state" \
        "$DIX_SOURCE_ROOT/modules/dix/cli" \
        "$DIX_SOURCE_ROOT/modules/dix/norn" \
        "$DIX_SOURCE_ROOT/modules/dix/roba" \
        "$runtime_module" <<'PY'
from __future__ import annotations

import json
import sys
from pathlib import Path

source, target, state, cli, norn, roba, cockpit = map(Path, sys.argv[1:])
value = source.read_text()
for marker, path in {
    '"@DIX_STATE_MODULE@"': state,
    '"@DIX_CLI_MODULE@"': cli,
    '"@DIX_NORN_MODULE@"': norn,
    '"@DIX_ROBA_MODULE@"': roba,
    '"@SKALDOS_COCKPIT_MODULE@"': cockpit,
}.items():
    value = value.replace(marker, json.dumps(str(path.resolve())))
target.write_text(value)
PY
    "$DIX_VENV/bin/python" -m dix.bootstrap build \
        "$launcher_spec" \
        --output "$DIX_LAUNCHERS/$name.py" \
        --replace
done

cp "$integration_root/tmux/cockpit.conf" "$DIX_LAUNCHERS/cockpit/tmux.conf"
cp "$integration_root/zsh/.zshrc" "$DIX_LAUNCHERS/cockpit/zsh/.zshrc"
cp "$module_root/assets/dix.png" "$DIX_LAUNCHERS/cockpit/assets/dix.png"
cp "$module_root/assets/roba.png" "$DIX_LAUNCHERS/cockpit/assets/roba.png"
chmod 0600 "$DIX_LAUNCHERS/cockpit/tmux.conf" "$DIX_LAUNCHERS/cockpit/zsh/.zshrc"
chmod 0600 "$DIX_LAUNCHERS/cockpit/assets/dix.png" "$DIX_LAUNCHERS/cockpit/assets/roba.png"
for name in \
    dix-cockpit \
    dix-cockpit-shell \
    dix-cockpit-runtime-status \
    dix-cockpit-clipboard-copy \
    dix-cockpit-clipboard-paste
do
    cp "$integration_root/bin/$name" "$DIX_BIN/$name"
    chmod 0755 "$DIX_BIN/$name"
done
chmod 0755 "$DIX_LAUNCHERS"/dix-cockpit*.py


printf 'installed privileged DIX Cockpit launchers in %s\n' "$DIX_LAUNCHERS"
printf 'installed DIX Cockpit commands in %s\n' "$DIX_BIN"
