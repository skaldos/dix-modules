#!/bin/sh
set -eu

integration_root=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
module_root=$(CDPATH='' cd "$integration_root/.." && pwd -P)
modules_root=$(CDPATH='' cd "$module_root/.." && pwd -P)
visidata_root=${SKALDOS_VISIDATA_ROOT:-$modules_root/visidata}
env_file=${DIX_ENV:-$HOME/.dix/env}

[ -r "$env_file" ] || {
    printf 'DIX environment file is not readable: %s\n' "$env_file" >&2
    exit 1
}
. "$env_file"

for variable in DIX_SOURCE_ROOT DIX_VENV DIX_LAUNCHERS DIX_BIN; do
    eval "value=\${$variable:-}"
    [ -n "$value" ] || {
        printf 'DIX environment value is missing: %s\n' "$variable" >&2
        exit 1
    }
done
[ -x "$DIX_VENV/bin/python" ] || {
    printf 'DIX environment Python is not executable: %s\n' "$DIX_VENV/bin/python" >&2
    exit 1
}

for module in \
    "$DIX_SOURCE_ROOT/modules/dix/state" \
    "$DIX_SOURCE_ROOT/modules/dix/cli" \
    "$DIX_SOURCE_ROOT/modules/dix/norn" \
    "$DIX_SOURCE_ROOT/modules/dix/roba" \
    "$visidata_root" \
    "$module_root"
do
    [ -d "$module" ] || {
        printf 'DIX module root is not a directory: %s\n' "$module" >&2
        exit 1
    }
done

mkdir -p "$DIX_LAUNCHERS/cockpit/assets" "$DIX_LAUNCHERS/cockpit/zsh" "$DIX_BIN"
chmod 0700 "$DIX_LAUNCHERS/cockpit" "$DIX_LAUNCHERS/cockpit/assets" "$DIX_LAUNCHERS/cockpit/zsh"

for name in dix-cockpit dix-cockpit-owner-shell dix-cockpit-runtime-status; do
    launcher_spec="$DIX_LAUNCHERS/$name.toml"
    "$DIX_VENV/bin/python" - \
        "$integration_root/launchers/$name.toml" \
        "$launcher_spec" \
        "$DIX_SOURCE_ROOT/modules/dix/state" \
        "$DIX_SOURCE_ROOT/modules/dix/cli" \
        "$DIX_SOURCE_ROOT/modules/dix/norn" \
        "$DIX_SOURCE_ROOT/modules/dix/roba" \
        "$visidata_root" \
        "$module_root" <<'PY'
from __future__ import annotations

import json
import sys
from pathlib import Path

source, target, state, cli, norn, roba, visidata, cockpit = map(Path, sys.argv[1:])
value = source.read_text()
for marker, path in {
    '"@DIX_STATE_MODULE@"': state,
    '"@DIX_CLI_MODULE@"': cli,
    '"@DIX_NORN_MODULE@"': norn,
    '"@DIX_ROBA_MODULE@"': roba,
    '"@SKALDOS_VISIDATA_MODULE@"': visidata,
    '"@SKALDOS_COCKPIT_MODULE@"': cockpit,
}.items():
    value = value.replace(marker, json.dumps(str(path.resolve())))
target.write_text(value)
PY
    "$DIX_VENV/bin/python" -m dix.bootstrap build \
        "$launcher_spec" \
        --output "$DIX_LAUNCHERS/$name.py" \
        --replace
done

cp "$integration_root/tmux/cockpit.conf" "$DIX_LAUNCHERS/cockpit/tmux.conf"
cp "$integration_root/zsh/.zshrc" "$DIX_LAUNCHERS/cockpit/zsh/.zshrc"
cp "$module_root/assets/dix.png" "$DIX_LAUNCHERS/cockpit/assets/dix.png"
cp "$module_root/assets/roba.png" "$DIX_LAUNCHERS/cockpit/assets/roba.png"
chmod 0600 "$DIX_LAUNCHERS/cockpit/tmux.conf" "$DIX_LAUNCHERS/cockpit/zsh/.zshrc"
chmod 0600 "$DIX_LAUNCHERS/cockpit/assets/dix.png" "$DIX_LAUNCHERS/cockpit/assets/roba.png"
for name in \
    dix-cockpit \
    dix-cockpit-shell \
    dix-cockpit-runtime-status \
    dix-cockpit-clipboard-copy \
    dix-cockpit-clipboard-paste
do
    cp "$integration_root/bin/$name" "$DIX_BIN/$name"
    chmod 0755 "$DIX_BIN/$name"
done
chmod 0755 "$DIX_LAUNCHERS"/dix-cockpit*.py


printf 'installed privileged DIX Cockpit launchers in %s\n' "$DIX_LAUNCHERS"
printf 'installed DIX Cockpit commands in %s\n' "$DIX_BIN"
