#!/bin/sh
set -eu

env_file=${DIX_ENV:-$HOME/.dix/env}
[ -r "$env_file" ] || {
    printf 'DIX environment file is not readable: %s\n' "$env_file" >&2
    exit 1
}
. "$env_file"

export DIX_COCKPIT_ZSH_CONFIG="${DIX_COCKPIT_ZSH_CONFIG:-$DIX_LAUNCHERS/cockpit/zsh/.zshrc}"

exec "$DIX_VENV/bin/python" "$DIX_LAUNCHERS/dix-cockpit-owner-shell.py" "$@"
