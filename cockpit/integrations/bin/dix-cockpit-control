#!/bin/sh
set -eu

env_file=${DIX_ENV:-$HOME/.dix/env}
. "$env_file"
: "${DIX_VENV:?DIX_VENV is missing from the DIX environment}"
: "${DIX_LAUNCHERS:?DIX_LAUNCHERS is missing from the DIX environment}"
: "${DIX_BIN:?DIX_BIN is missing from the DIX environment}"
export DIX_COCKPIT_TMUX_CONFIG=${DIX_COCKPIT_TMUX_CONFIG:-$DIX_LAUNCHERS/cockpit/tmux.conf}
export DIX_COCKPIT_CLIPBOARD_COPY=${DIX_COCKPIT_CLIPBOARD_COPY:-$DIX_BIN/dix-cockpit-clipboard-copy}
export DIX_COCKPIT_CLIPBOARD_PASTE=${DIX_COCKPIT_CLIPBOARD_PASTE:-$DIX_BIN/dix-cockpit-clipboard-paste}
exec "$DIX_VENV/bin/python" "$DIX_LAUNCHERS/dix-cockpit-control.py" "$@"
