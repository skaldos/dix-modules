#!/bin/sh
set -eu

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    exec wl-paste --no-newline
fi

if [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard -out
fi

socket=${DIX_COCKPIT_TMUX_SOCKET:?DIX_COCKPIT_TMUX_SOCKET is required for tmux fallback}
tmux_bin=${DIX_COCKPIT_TMUX_BIN:-tmux}
"$tmux_bin" -S "$socket" display-message "System clipboard unavailable; pasting Cockpit tmux buffer"
printf '%s\n' 'System clipboard unavailable; pasting Cockpit tmux buffer' >&2
exec "$tmux_bin" -S "$socket" save-buffer -
