#!/bin/sh
set -eu

env_file=${DIX_ENV:-$HOME/.dix/env}
[ -r "$env_file" ] || {
    printf 'DIX environment file is not readable: %s\n' "$env_file" >&2
    exit 1
}
. "$env_file"

export DIX_COCKPIT_ASSET_ROOT="${DIX_COCKPIT_ASSET_ROOT:-$DIX_LAUNCHERS/cockpit/assets}"

exec "$DIX_VENV/bin/python" "$DIX_LAUNCHERS/dix-cockpit-runtime-status.py" "$@"
