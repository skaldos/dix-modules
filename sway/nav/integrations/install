#!/bin/sh
set -eu

integration_root=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
env_file=${DIX_ENV:-$HOME/.dix/env}

if [ ! -e "$env_file" ]; then
    mkdir -p "$(dirname "$env_file")"
    cp "$integration_root/env" "$env_file"
    printf 'created %s\n' "$env_file"
fi

[ -r "$env_file" ] || {
    printf 'DIX environment file is not readable: %s\n' "$env_file" >&2
    exit 1
}
. "$env_file"

for variable in DIX_SOURCE_ROOT DIX_VENV DIX_LAUNCHERS DIX_BIN SKALDOS_SWAY_ROOT; do
    eval "value=\${$variable:-}"
    [ -n "$value" ] || {
        printf 'DIX environment value is missing: %s\n' "$variable" >&2
        exit 1
    }
done

[ -x "$DIX_VENV/bin/python" ] || {
    printf 'DIX environment Python is not executable: %s\n' "$DIX_VENV/bin/python" >&2
    exit 1
}

for module in \
    "$DIX_SOURCE_ROOT/modules/dix/cli" \
    "$SKALDOS_SWAY_ROOT/core" \
    "$SKALDOS_SWAY_ROOT/nav"
do
    [ -d "$module" ] || {
        printf 'DIX module root is not a directory: %s\n' "$module" >&2
        exit 1
    }
done

mkdir -p "$DIX_LAUNCHERS" "$DIX_BIN"

cp "$integration_root/launchers/dix-sway-nav.py" "$DIX_LAUNCHERS/dix-sway-nav.py"
cp "$integration_root/bin/dix-sway-nav" "$DIX_BIN/dix-sway-nav"
cp "$integration_root/bin/dix-sway-nav-cli" "$DIX_BIN/dix-sway-nav-cli"

launcher_spec="$DIX_LAUNCHERS/dix-sway-nav-cli.toml"
"$DIX_VENV/bin/python" - \
    "$integration_root/launchers/dix-sway-nav-cli.toml" \
    "$launcher_spec" \
    "$DIX_SOURCE_ROOT/modules/dix/cli" \
    "$SKALDOS_SWAY_ROOT/core" \
    "$SKALDOS_SWAY_ROOT/nav" <<'PY'
from __future__ import annotations

import json
import sys
from pathlib import Path

source, target, cli, core, nav = map(Path, sys.argv[1:])
value = source.read_text()
for marker, path in {
    '"@DIX_CLI_MODULE@"': cli,
    '"@SKALDOS_SWAY_CORE@"': core,
    '"@SKALDOS_SWAY_NAV@"': nav,
}.items():
    value = value.replace(marker, json.dumps(str(path.resolve())))
target.write_text(value)
PY

"$DIX_VENV/bin/python" -m dix.bootstrap build \
    "$launcher_spec" \
    --output "$DIX_LAUNCHERS/dix-sway-nav-cli.py" \
    --replace

rm -f \
    "$DIX_LAUNCHERS/skaldos-sway-nav.py" \
    "$DIX_LAUNCHERS/skaldos-sway-nav.toml" \
    "$DIX_BIN/skaldos-sway-nav"

chmod 0755 \
    "$DIX_LAUNCHERS/dix-sway-nav.py" \
    "$DIX_LAUNCHERS/dix-sway-nav-cli.py" \
    "$DIX_BIN/dix-sway-nav" \
    "$DIX_BIN/dix-sway-nav-cli"

printf 'installed Sway navigation launchers in %s\n' "$DIX_LAUNCHERS"
printf 'installed Sway navigation commands in %s\n' "$DIX_BIN"
