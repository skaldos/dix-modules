#!/bin/sh
set -eu
manage=${SKALDOS_SWAY_MANAGEMENT:-skaldos-sway-json}
choose_group() {
  if [ -n "${SKALDOS_SWAY_WOFI:-}" ]; then
    sh -c "$SKALDOS_SWAY_WOFI"
  else
    wofi --dmenu --no-custom-entry --prompt 'Add window to group'
  fi
}
read_name() {
  if [ -n "${SKALDOS_SWAY_WOFI_NAME:-}" ]; then
    sh -c "$SKALDOS_SWAY_WOFI_NAME"
  else
    wofi --dmenu --prompt 'New group name'
  fi
}
groups=$($manage list-lines)
entries=$(printf '%s\n' "$groups" | sed '/^$/d; s/^/  /')
choice=$(printf '%s\n%s\n' '[+ New group]' "$entries" | sed '/^$/d' | choose_group) || exit 0
if [ "$choice" = '[+ New group]' ]; then
  choice=$(printf '' | read_name) || exit 0
  [ -n "$choice" ] || exit 0
  "$manage" create "$choice"
elif [ "${choice#  }" != "$choice" ]; then
  choice=${choice#  }
else
  printf 'invalid Wofi selection\n' >&2
  exit 1
fi
exec "$manage" add "$choice"
