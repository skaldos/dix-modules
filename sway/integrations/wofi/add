#!/bin/sh
set -eu
manage=${SKALDOS_SWAY_MANAGEMENT:-skaldos-sway-json}
menu=${SKALDOS_SWAY_WOFI:-wofi --dmenu --prompt 'Zu Gruppe'}
groups=$($manage list-lines)
choice=$(printf '%s\n%s\n' '+ Neue Gruppe' "$groups" | sed '/^$/d' | sh -c "$menu") || exit 0
if [ "$choice" = '+ Neue Gruppe' ]; then
  choice=$(printf '' | sh -c "${SKALDOS_SWAY_WOFI_NAME:-wofi --dmenu --prompt 'Neue Gruppe'}") || exit 0
  [ -n "$choice" ] || exit 0
  "$manage" create "$choice"
fi
exec "$manage" add "$choice"
