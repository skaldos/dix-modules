#!/bin/sh
set -eu
manage=${SKALDOS_SWAY_MANAGEMENT:-skaldos-sway-json}
menu=${SKALDOS_SWAY_WOFI:-wofi --dmenu --prompt 'Sway group'}
groups=$($manage list-lines)
entries=$(printf '%s\n' "$groups" | sed '/^$/d; s/^/  /')
choice=$(printf '%s\n%s\n%s\n' '[Keine Gruppe]' '[+ Neue Gruppe]' "$entries" | sed '/^$/d' | sh -c "$menu") || exit 0
case "$choice" in
  '[Keine Gruppe]') exec "$manage" deactivate ;;
  '[+ Neue Gruppe]')
    name=$(printf '' | sh -c "${SKALDOS_SWAY_WOFI_NAME:-wofi --dmenu --prompt 'Neue Gruppe'}") || exit 0
    [ -n "$name" ] || exit 0
    "$manage" create "$name"; exec "$manage" select "$name" ;;
  '  '*) exec "$manage" select "${choice#  }" ;;
  *) printf 'invalid Wofi selection\n' >&2; exit 1 ;;
esac
