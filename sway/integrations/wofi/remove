#!/bin/sh
set -eu
manage=${SKALDOS_SWAY_MANAGEMENT:-skaldos-sway-json}
menu=${SKALDOS_SWAY_WOFI:-wofi --dmenu --prompt 'Aus Gruppe'}
groups=$($manage memberships-lines)
[ -n "$groups" ] || exit 0
entries=$(printf '%s\n' "$groups" | sed '/^$/d; s/^/  /')
choice=$(printf '%s\n' "$entries" | sh -c "$menu") || exit 0
[ -n "$choice" ] || exit 0
if [ "${choice#  }" = "$choice" ]; then
  printf 'invalid Wofi selection\n' >&2
  exit 1
fi
exec "$manage" remove "${choice#  }"
