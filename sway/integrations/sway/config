# Replace this one path with the documented clone location.
set $skaldos_sway /absolute/path/to/workspace/dix/modules/skaldos/sway

# Fixed bindings: no Sway mode and no runtime rebinding.
bindsym $mod+h exec --no-startup-id skaldos-sway-nav left
bindsym $mod+j exec --no-startup-id skaldos-sway-nav down
bindsym $mod+k exec --no-startup-id skaldos-sway-nav up
bindsym $mod+l exec --no-startup-id skaldos-sway-nav right

